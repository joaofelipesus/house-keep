<% if modal_request? %>
  <turbo-frame id="modal-frame">
    <%= render "form", income: @income, url: incomes_path(modal: true) %>
  </turbo-frame>
<% else %>
  <% content_for :title, t('.title') %>

  <div class="page-header">
    <h1 class="page-title"><%= t('.title') %></h1>
    <div class="page-actions">
      <%= link_to t('.back'), incomes_path, class: "btn btn-ghost btn-sm" %>
    </div>
  </div>

  <%= render "form", income: @income, url: incomes_path %>
<% end %>
