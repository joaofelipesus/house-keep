<% content_for :title, t('.title') %>

<div class="page-header">
  <h1 class="page-title"><%= t('.title') %></h1>
  <div class="page-actions">
    <%= link_to t('.back'), incomes_path, class: "btn btn-ghost btn-sm" %>
    <%= button_to t('.destroy_income'), @income, method: :delete, class: "btn btn-danger btn-sm" %>
  </div>
</div>

<%= render "form", income: @income %>
