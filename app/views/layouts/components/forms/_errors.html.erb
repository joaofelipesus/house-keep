<%# locals: (record:) %>

<% if record.errors.any? %>
  <div class="form-errors">
    <p class="form-errors-title"><%= pluralize(record.errors.count, "error") %> prohibited this <%= record.class.name.downcase %> from being saved:</p>
    <ul>
      <% record.errors.each do |error| %>
        <li><%= error.full_message %></li>
      <% end %>
    </ul>
  </div>
<% end %>
