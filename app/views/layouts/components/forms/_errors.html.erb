<%# locals: (record:) %>

<% if record.errors.any? %>
  <div class="form-errors">
    <p class="form-errors-title"><%= t('.header', count: record.errors.count, model: record.class.model_name.human.downcase) %></p>
    <ul>
      <% record.errors.each do |error| %>
        <li><%= error.full_message %></li>
      <% end %>
    </ul>
  </div>
<% end %>
