<nav class="navbar">
  <% if authenticated? %>
    <%= link_to root_path, class: "navbar-brand" do %>
      <%= render partial: 'layouts/components/brand' %>
    <% end %>

    <div class="navbar-links">
      <%= link_to Bill.model_name.human(count: 2), bills_path %>
      <%= link_to t('.current_incomes'), current_incomes_path %>
    </div>

    <% income = CurrentIncome.active.last %>
    <div class="navbar-right">
      <div class="navbar-income">
        <span class="navbar-income-label"><%= t('.income_label') %></span>
        <span class="navbar-income-value">
          <% if income %>
            <%= number_to_currency(income.value, unit: "R$", separator: ",", delimiter: ".") %>
          <% else %>
            <%= t('.no_income') %>
          <% end %>
        </span>
      </div>

      <%= button_to t('.sign_out'), session_path,
                    method: :delete,
                    class: "btn btn-ghost btn-sm",
                    form_class: "navbar-signout" %>
    </div>
  <% else %>
    <%# Signed out: branding only, no navigation and no financial data. %>
    <div class="navbar-brand">
      <%= render partial: 'layouts/components/brand' %>
    </div>
  <% end %>
</nav>
