<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "House Keep" %></title>
    <%# viewport-fit=cover lets the page paint behind the notch; the CSS pads it back with
        env(safe-area-inset-*) so nothing important lands under it. %>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="theme-color" content="#4f46e5">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-title" content="HouseKeep">
    <meta name="apple-mobile-web-app-status-bar-style" content="default">
    <meta name="application-name" content="House Keep">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <%# iOS ignores the manifest icons for the home screen and uses this one. %>
    <link rel="apple-touch-icon" href="/icon-180.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <%= render(partial: 'layouts/components/navbar') %>

    <main class="main-content">
      <%= yield %>
    </main>
  </body>
</html>
