<p style="color: green"><%= notice %></p>

<% content_for :title, t('.title') %>

<h1><%= t('.title') %></h1>

<div id="bills">
  <% @bills.each do |bill| %>
    <%= render bill %>
    <p>
      <%= link_to t('.show_bill'), bill %>
    </p>
  <% end %>
</div>

<%= link_to t('.new_bill'), new_bill_path %>
