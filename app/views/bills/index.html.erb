<% content_for :title, t('.title') %>

<div class="page-header">
  <h1 class="page-title"><%= t('.title') %></h1>
  <%= link_to t('.new_bill'), new_bill_path, class: "btn btn-primary" %>
</div>

<% if notice.present? %>
  <p class="flash flash-notice"><%= notice %></p>
<% end %>

<div class="table-wrapper">
  <table class="table">
    <thead>
      <tr>
        <th><%= Bill.human_attribute_name(:title) %></th>
        <th><%= Bill.human_attribute_name(:value) %></th>
        <th><%= t('.due') %></th>
        <th><%= Bill.human_attribute_name(:payment_method) %></th>
        <th><%= Bill.human_attribute_name(:recurring) %></th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% if @bills.any? %>
        <% @bills.each do |bill| %>
          <tr>
            <td>
              <div class="table-name">
                <div class="table-logo">
                  <% if bill.company_logo.attached? %>
                    <%= image_tag bill.company_logo, class: "table-logo-img" %>
                  <% else %>
                    <span class="table-logo-placeholder"><%= bill.title.first.upcase %></span>
                  <% end %>
                </div>
                <div class="table-info">
                  <span class="table-title"><%= bill.title %></span>
                  <% if bill.description.present? %>
                    <span class="table-description"><%= bill.description %></span>
                  <% end %>
                </div>
              </div>
            </td>
            <td class="table-value"><%= number_to_currency(bill.value, unit: "R$", separator: ",", delimiter: ".") %></td>
            <td class="table-muted">
              <% if bill.recurring? %>
                <%= t('.due') %> <%= bill.recurrent_due_day %>
              <% else %>
                <%= l(bill.due_date, format: :short) %>
              <% end %>
            </td>
            <td class="table-muted"><%= bill.payment_method.presence || "—" %></td>
            <td>
              <% if bill.recurring? %>
                <span class="bill-badge"><%= Bill.human_attribute_name(:recurring) %></span>
              <% end %>
            </td>
            <td class="table-actions">
              <%= link_to t('.open_bill'), bill_path(bill), class: "btn btn-ghost btn-sm" %>
            </td>
          </tr>
        <% end %>
      <% else %>
        <tr>
          <td colspan="6" class="table-empty"><%= t('.no_bills') %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
