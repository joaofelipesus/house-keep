<div id="<%= dom_id bill %>">
  <div>
    <strong>Recurring:</strong>
    <%= bill.recurring %>
  </div>

  <div>
    <strong>Value:</strong>
    <%= bill.value %>
  </div>

  <div>
    <strong>Title:</strong>
    <%= bill.title %>
  </div>

  <div>
    <strong>Due date:</strong>
    <%= bill.due_date %>
  </div>

  <div>
    <strong>Description:</strong>
    <%= bill.description %>
  </div>

  <div>
    <strong>Payment method:</strong>
    <%= bill.payment_method %>
  </div>

</div>
