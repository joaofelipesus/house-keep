<%= form_with(model: bill, class: "form") do |form| %>
  <%= render(partial: 'layouts/components/forms/errors', locals: { record: bill }) %>

  <div class="form-field form-field-inline">
    <%= form.label :recurring %>
    <%= form.checkbox :recurring %>
  </div>

  <div class="form-field">
    <%= form.label :value %>
    <%= form.text_field :value %>
  </div>

  <div class="form-field">
    <%= form.label :title %>
    <%= form.text_field :title %>
  </div>

  <div class="form-field">
    <%= form.label :due_date %>
    <%= form.date_field :due_date %>
  </div>

  <div class="form-field">
    <%= form.label :description %>
    <%= form.textarea :description %>
  </div>

  <div class="form-field">
    <%= form.label :payment_method %>
    <%= form.text_field :payment_method %>
  </div>

  <div class="form-submit">
    <%= form.submit %>
  </div>
<% end %>
