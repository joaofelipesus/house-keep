<%= form_with(model: bill, class: "form", data: { 'controller' => 'bills--form'}) do |form| %>
  <%= render(partial: 'layouts/components/forms/errors', locals: { record: bill }) %>

  <div class="form-field">
    <%= form.label :title %>
    <%= form.text_field :title %>
  </div>

  <div class="form-field">
    <%= form.label :value %>
    <%= form.text_field :value %>
  </div>

  <div class="form-field form-field-inline">
    <%= form.label :recurring %>
    <%=
      form.checkbox(
        :recurring,
        data: {
          'action' => 'change->bills--form#toggleRecurring',
          'bills--form-target' => 'recurringInput'
        }
      )
    %>
  </div>

  <div
    class="form-field"
    data-bills--form-target="nonRecurringSection"
  >
    <%= form.label :due_date %>
    <%= form.date_field :due_date %>
  </div>

  <div class="form-section" data-bills--form-target="recurringSection">
    <div class="form-field">
      <%= form.label :recurrent_due_day %>
      <%= form.number_field :recurrent_due_day, min: 1, max: 31 %>
    </div>

    <div class="form-field">
      <%= form.label :payment_method %>
      <%=
        form.select(
          :payment_method,
          Bill.payment_methods.keys.map { |k| [t("activerecord.attributes.bill.payment_methods.#{k}"), k] },
          { include_blank: true }
        )
      %>
    </div>
  </div>

  <div class="form-field">
    <%= form.label :description %>
    <%= form.textarea :description %>
  </div>

  <div class="form-field">
    <%= form.label :company_logo, class: "file-upload" do %>
      <%= form.file_field :company_logo, accept: "image/*", class: "file-upload-input" %>
      <span class="file-upload-label"><%= Bill.human_attribute_name(:company_logo) %></span>
      <span class="file-upload-hint"><%= t('.company_logo_hint') %></span>
    <% end %>
  </div>

  <div class="form-submit">
    <%= form.submit %>
  </div>
<% end %>
