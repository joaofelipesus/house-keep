<%# locals: (incomes:, total:) %>

<section class="statement-section">
  <header class="statement-section-header">
    <h2 class="statement-section-title"><%= t('.title') %></h2>
    <span class="statement-section-total statement-amount-positive"><%= money(total) %></span>
  </header>

  <div class="table-wrapper">
    <table class="table">
      <thead>
        <tr>
          <th><%= Income.human_attribute_name(:title) %></th>
          <th><%= Income.human_attribute_name(:category) %></th>
          <th><%= Income.human_attribute_name(:received_on) %></th>
          <th><%= Income.human_attribute_name(:value) %></th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% if incomes.any? %>
          <% incomes.each do |income| %>
            <tr>
              <td>
                <div class="table-info">
                  <span class="table-title"><%= income.title %></span>
                  <% if income.description.present? %>
                    <span class="table-description"><%= income.description %></span>
                  <% end %>
                </div>
              </td>
              <td class="table-muted">
                <%= t("activerecord.attributes.income.categories.#{income.category}") %>
              </td>
              <td class="table-muted"><%= l(income.received_on, format: :short) %></td>
              <td class="table-value statement-amount-positive"><%= money(income.value) %></td>
              <td class="table-actions">
                <%= link_to t('.edit'), edit_income_path(income), class: "btn btn-ghost btn-sm" %>
              </td>
            </tr>
          <% end %>
        <% else %>
          <tr>
            <td colspan="5" class="table-empty"><%= t('.empty') %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</section>
