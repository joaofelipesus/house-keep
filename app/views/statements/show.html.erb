<% content_for :title, t('.title') %>

<div class="page-header">
  <h1 class="page-title"><%= t('.title') %></h1>
  <div class="page-actions">
    <%= link_to t('.new_income'), new_income_path, class: "btn btn-ghost btn-sm" %>
    <%= link_to t('.new_expense'), new_expense_path, class: "btn btn-primary btn-sm" %>
  </div>
</div>

<% if notice.present? %>
  <p class="flash flash-notice"><%= notice %></p>
<% end %>

<div class="statement-nav">
  <%# The label collapses on a narrow screen, so each arrow keeps an accessible name of its own. %>
  <%= link_to statement_path(month: @statement.prev_month.strftime('%Y-%m')),
              class: "btn btn-ghost btn-sm",
              aria: { label: t('.previous_month') } do %>
    <span aria-hidden="true">&larr;</span>
    <span class="statement-nav-label"><%= t('.previous_month') %></span>
  <% end %>

  <span class="statement-nav-month"><%= month_title(@statement.month) %></span>

  <%= link_to statement_path(month: @statement.next_month.strftime('%Y-%m')),
              class: "btn btn-ghost btn-sm",
              aria: { label: t('.next_month') } do %>
    <span class="statement-nav-label"><%= t('.next_month') %></span>
    <span aria-hidden="true">&rarr;</span>
  <% end %>
</div>

<%= render partial: 'statements/components/summary', locals: { statement: @statement } %>

<%= render partial: 'statements/components/incomes', locals: { incomes: @statement.incomes, total: @statement.incomes_total } %>
<%= render partial: 'statements/components/invoices', locals: { invoices: @statement.invoices, total: @statement.invoices_total } %>
<%= render partial: 'statements/components/expenses', locals: { expenses: @statement.expenses, total: @statement.expenses_total } %>
