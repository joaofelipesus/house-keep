<% content_for :title, t('.title') %>

<div class="page-header">
  <h1 class="page-title"><%= t('.title') %></h1>
  <div class="page-actions">
    <%= link_to t('.statement'), statement_path, class: "btn btn-ghost btn-sm" %>
    <%= link_to t('.new_expense'), new_expense_path, class: "btn btn-primary btn-sm" %>
  </div>
</div>

<% if notice.present? %>
  <p class="flash flash-notice"><%= notice %></p>
<% end %>

<div class="table-wrapper">
  <table class="table">
    <thead>
      <tr>
        <th><%= Expense.human_attribute_name(:title) %></th>
        <th><%= Expense.human_attribute_name(:category) %></th>
        <th><%= Expense.human_attribute_name(:spent_on) %></th>
        <th><%= Expense.human_attribute_name(:payment_method) %></th>
        <th><%= Expense.human_attribute_name(:value) %></th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% if @expenses.any? %>
        <% @expenses.each do |expense| %>
          <tr>
            <td>
              <div class="table-info">
                <span class="table-title"><%= expense.title %></span>
                <% if expense.description.present? %>
                  <span class="table-description"><%= expense.description %></span>
                <% end %>
              </div>
            </td>
            <td class="table-muted">
              <%= t("activerecord.attributes.expense.categories.#{expense.category}") %>
            </td>
            <td class="table-muted"><%= l(expense.spent_on, format: :short) %></td>
            <td class="table-muted">
              <%= display_value(expense.payment_method && t("activerecord.attributes.expense.payment_methods.#{expense.payment_method}")) %>
            </td>
            <td class="table-value statement-amount-negative"><%= money(expense.value) %></td>
            <td class="table-actions">
              <%= link_to t('.edit'), edit_expense_path(expense), class: "btn btn-ghost btn-sm" %>
            </td>
          </tr>
        <% end %>
      <% else %>
        <tr>
          <td colspan="6" class="table-empty"><%= t('.no_expenses') %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
