<% content_for :title, t('.title') %>

<div class="page-header">
  <h1 class="page-title"><%= t('.title') %></h1>
  <div class="page-actions">
    <%= link_to t('.back'), expenses_path, class: "btn btn-ghost btn-sm" %>
    <%= button_to t('.destroy_expense'), @expense, method: :delete, class: "btn btn-danger btn-sm" %>
  </div>
</div>

<%= render "form", expense: @expense %>
