<%# locals: (invoice:) %>
<%= form_with(model: invoice, class: "form") do |form| %>
  <%= render partial: 'layouts/components/forms/errors', locals: { record: invoice } %>

  <div class="form-field">
    <%= form.label :payment_status %>
    <%= form.select :payment_status, Invoice.payment_statuses.keys.map { |s| [t("activerecord.attributes.invoice.payment_statuses.#{s}"), s] } %>
  </div>

  <div class="form-field">
    <%= form.label :payment_date %>
    <%= form.date_field :payment_date, value: Date.current %>
  </div>

  <div class="form-field">
    <%= form.label :payment_amount %>
    <%= form.text_field :payment_amount %>
  </div>

  <div class="form-submit">
    <%= form.submit %>
  </div>
<% end %>
