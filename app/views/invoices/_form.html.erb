<%# locals: (invoice:) %>
<%= form_with(model: invoice, class: "form") do |form| %>
  <%= render partial: 'layouts/components/forms/errors', locals: { record: invoice } %>

  <div class="form-field">
    <%= form.label :payment_status %>
    <%= invoice.show_current_payment_status %>
  </div>

  <div class="form-field">
    <%= form.label :payment_date %>
    <%= form.date_field :payment_date %>
  </div>

  <div class="form-field">
    <%= form.label :payment_amount %>
    <%= form.text_field :payment_amount %>
  </div>

  <div class="form-submit">
    <%= form.submit %>
  </div>
<% end %>
